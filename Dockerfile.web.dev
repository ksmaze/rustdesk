# =============================================================================
# Dockerfile.web.dev - Dev environment for RustDesk Flutter Web Client
# =============================================================================
# Usage:
#   docker compose -f docker-compose.web.dev.yml up --build
#
# This creates a persistent dev container with Flutter + Node.js pre-installed.
# Source files are mounted from the host, so edits are instant.
# Run builds inside the container and serve from the build output.
# =============================================================================

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV FLUTTER_VERSION=3.24.5

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        git \
        wget \
        unzip \
        xz-utils \
        libgconf-2-4 \
        libstdc++6 \
        fonts-droid-fallback \
        clang \
        cmake \
        ninja-build \
        pkg-config \
        libgtk-3-dev \
        python3 \
        protobuf-compiler \
        ca-certificates && \
    ln -sf /usr/bin/python3 /usr/bin/python && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install Flutter SDK
RUN git clone --branch ${FLUTTER_VERSION} --depth 1 https://github.com/flutter/flutter.git /usr/local/flutter
ENV PATH="/usr/local/flutter/bin:/usr/local/flutter/bin/cache/dart-sdk/bin:${PATH}"
RUN flutter precache --web && \
    flutter config --enable-web

# Install Node.js 22.x LTS
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --allow-downgrades nodejs && \
    npm install -g yarn typescript

# Dev helper script
COPY docker/web/dev-build.sh /usr/local/bin/dev-build
RUN chmod +x /usr/local/bin/dev-build

WORKDIR /app/rustdesk
EXPOSE 5000

# Default: keep container alive for interactive use
CMD ["bash", "-c", "echo '==> Dev container ready. Run: dev-build' && sleep infinity"]
